{
  "name": "skillver-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Skillver Web — AI talent copilot (greenfield UI from product manual)",
  "scripts": {
    "dev": "vite",
    "build": "npm run tokens:build && vue-tsc -b && vite build",
    "preview": "vite preview",
    "tokens:build": "style-dictionary build --config style-dictionary.config.mjs",
    "design:validate": "node ../../scripts/validate-design.mjs DESIGN.md",
    "dev:port": "node -e \"import { getDevPortFromRoot } from './scripts/lib/dev-port.mjs'; console.log(getDevPortFromRoot('.'))\""
  },
  "dependencies": {
    "@xstate/vue": "^5.0.0",
    "vue": "^3.5.34",
    "vue-router": "^4.5.0",
    "xstate": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "style-dictionary": "^4.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  },
  "engines": {
    "node": ">=20"
  }
}
