{
  "name": "dev-platform-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "软件开发平台 — 交互与界面设计模块 MVP",
  "scripts": {
    "dev": "vite",
    "build": "npm run tokens:build && vue-tsc -b && vite build",
    "static:build": "npm run tokens:build && vite-node scripts/bake-design-static-data.ts && vue-tsc -b && vite build --base /AI_to_Design/ && node scripts/copy-spa-fallback.mjs",
    "static:preview": "vite preview --base /AI_to_Design/",
    "preview": "vite preview",
    "tokens:build": "style-dictionary build --config style-dictionary.config.mjs",
    "design:validate": "node ../../scripts/validate-design.mjs products/dev-platform-web/output/demo-saas/DESIGN.md",
    "aesthetic:validate-golden": "node ../../scripts/validate-aesthetic-golden.mjs",
    "design:export": "node ../../scripts/skill-to-design.mjs",
    "static:export": "vite-node scripts/export-static-previews.ts",
    "dev:port": "node -e \"import { getDevPortFromRoot } from './scripts/lib/dev-port.mjs'; console.log(getDevPortFromRoot('.'))\""
  },
  "dependencies": {
    "@xstate/vue": "^5.0.0",
    "jszip": "^3.10.1",
    "vue": "^3.5.34",
    "vue-router": "^4.5.0",
    "xstate": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "style-dictionary": "^4.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vite-node": "^6.0.0",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  },
  "engines": {
    "node": ">=20"
  }
}
